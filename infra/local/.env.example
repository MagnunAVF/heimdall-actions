# Overrides for infra/local/docker-compose.yml. Copy to infra/local/.env (gitignored) and change what you
# need. Every value here is the dev-only default the stack uses when the variable is unset; never
# put real credentials in this file.

# PostgreSQL: postgres://heimdall:heimdall@localhost:5432/heimdall?sslmode=disable
POSTGRES_USER=heimdall
POSTGRES_PASSWORD=heimdall
POSTGRES_DB=heimdall
POSTGRES_PORT=5432

# Redis: redis://:heimdall@localhost:6379/0
REDIS_PASSWORD=heimdall
REDIS_PORT=6379

# Keycloak: http://localhost:8080 (admin console user)
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
